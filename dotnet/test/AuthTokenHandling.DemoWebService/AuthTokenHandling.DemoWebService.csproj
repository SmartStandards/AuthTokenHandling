<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AuthTokenHandling.DemoWebService</AssemblyName>
    <RootNamespace>Security</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>6.0.1-develop</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>.\bin\AuthTokenHandling.DemoWebService.xml</DocumentationFile>
    <OutputPath>.\bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>false</Deterministic>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>.\bin\AuthTokenHandling.DemoWebService.xml</DocumentationFile>
    <OutputPath>.\bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>false</Deterministic>
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <!-- https://stackoverflow.com/questions/57412190/how-to-include-xml-documentation-from-nuget-package-in-csproj-build-output -->
  <Target Name="_ResolveCopyLocalNuGetPkgXmls" AfterTargets="ResolveReferences">
    <ItemGroup><!-- Copy XML files from all PackageReferences to output dir -->
      <ReferenceCopyLocalPaths Include="@(ReferenceCopyLocalPaths->'%(RootDir)%(Directory)%(Filename).xml')" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)'!='' and Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Compile Remove="Util\**" />
    <Content Remove="Logs\**" />
    <Content Remove="Util\**" />
    <EmbeddedResource Remove="Logs\**" />
    <EmbeddedResource Remove="Util\**" />
    <None Remove="Logs\**" />
    <None Remove="Util\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Security.WebAPI.csproj.vspscc" />
    <None Remove="_AnnouncementInfo.txt" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Program.Main.cs">
      <DependentUpon>Program.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Properties\launchSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="jose-jwt" Version="5.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
    <PackageReference Include="SmartAmbience" Version="2.4.8" />
    <PackageReference Include="SmartAmbience.MvcSupport" Version="2.4.8" />
    <PackageReference Include="SmartStandards.Logging" Version="3.4.3" />
    <PackageReference Include="SmartStandards.Logging.AspSupport" Version="3.4.3" />
    <PackageReference Include="SmartStandards.Logging.Centralized" Version="3.4.3" />
    <PackageReference Include="Snowflake44" Version="3.7.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="4.6.0" />
    <PackageReference Include="UJMW.DynamicClient" Version="5.4.0" />
    <PackageReference Include="UJMW.DynamicController" Version="5.4.0" />
  </ItemGroup>

  <!-- T4 source snapshot of the SmartStandards-flavored Swagger extension (no reference to SmartStandards.WebApiDependencies => no cyclic dependency) -->
  <ItemGroup>
    <None Update="Swagger\SwaggerSetupExtensions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>SwaggerSetupExtensions.cs</LastGenOutput>
      <CustomToolNamespace>AuthTokenHandlingDemo</CustomToolNamespace>
    </None>
    <Compile Update="Swagger\SwaggerSetupExtensions.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>SwaggerSetupExtensions.tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- T4 source snapshot of 'LaunchProfileHelper' / 'AddBranchSpecificConfigurationFiles()' (required by the canonical Program.Main) -->
  <ItemGroup>
    <None Update="Hosting\SmartStandardsLaunchProfileExtensions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>SmartStandardsLaunchProfileExtensions.cs</LastGenOutput>
      <CustomToolNamespace>AuthTokenHandlingDemo</CustomToolNamespace>
    </None>
    <Compile Update="Hosting\SmartStandardsLaunchProfileExtensions.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>SmartStandardsLaunchProfileExtensions.tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AuthTokenHandling.MvcSupport.net10.0\AuthTokenHandling.MvcSupport.net10.0.csproj" />
    <ProjectReference Include="..\..\src\AuthTokenHandling.net10.0\AuthTokenHandling.net10.0.csproj" />
  </ItemGroup>

</Project>
